@model RaceDayy.Models.Category
@{
    ViewData["Title"] = "Edit category";
}
<h1 class="h3">Edit category</h1>
<p class="text-muted">@ViewBag.EventName</p>
<hr />
<div class="row">
    <div class="col-lg-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <partial name="_CategoryForm" model="Model" />
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
