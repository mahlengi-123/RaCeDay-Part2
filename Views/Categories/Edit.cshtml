@model RaceDayy.Models.Category
@{ ViewData["Title"] = "Edit category"; }
<h1 class="h3">Edit category</h1>
<p>@ViewBag.EventName</p>
<form asp-action="Edit" method="post">
<div asp-validation-summary="All" class="text-danger"></div>
<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="EventId" />
<div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Kind" class="form-label"></label><select asp-for="Kind" asp-items="Html.GetEnumSelectList<RaceDayy.Models.CategoryKind>()" class="form-select"></select></div>
<button type="submit" class="btn btn-primary">Save category</button>
<a asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-outline-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
