@model RaceDayy.Models.Event

@{
    ViewData["Title"] = "Create event";
}

<h1 class="h3">Create event</h1>
<hr />

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="All"
                 class="text-danger"></div>

            <partial name="_EventForm" model="Model" />

            <div class="mb-3">
                <label for="bannerFile" class="form-label">
                    Banner image
                </label>

                <input type="file"
                       id="bannerFile"
                       name="bannerFile"
                       class="form-control"
                       accept="image/jpeg,image/png,image/webp"
                       aria-describedby="bannerHelp" />

                <div id="bannerHelp" class="form-text">
                    Optional: choose a JPG, PNG or WebP image,
                    up to 5 MB.
                </div>

                @Html.ValidationMessage(
                "bannerFile",
                                null,
                                new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-primary">
                Create
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}