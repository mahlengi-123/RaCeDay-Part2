@{
    ViewData["Title"] = "Organiser dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Organiser dashboard</h1>

    @if (User.IsInRole("Organiser"))
    {
        <a asp-controller="Events"
           asp-action="Create"
           class="btn btn-primary">
            Create event
        </a>
    }
</div>

<p>Welcome! Create an event or manage your existing events.</p>

<a asp-controller="Events"
   asp-action="Index"
   class="btn btn-outline-primary">
    View events
</a>