@model List<RaCeDay.Models.ViewModels.ManageUserRolesViewModel>

@{
    ViewData["Title"] = "Manage User Roles";
    var userId = ViewBag.UserId as string;
}

<div class="container mt-4">

    <h2>
        Manage Roles for:
        <strong>@ViewBag.UserName</strong>
    </h2>

    <hr />

    <form method="post">

        <input type="hidden" name="userId" value="@userId" />

        <div class="card">

            <div class="card-header">
                Add / Remove Roles
            </div>

            <div class="card-body">

                @for (int i = 0; i < Model.Count; i++)
                {
                    <div class="form-check mt-1">

                        <input type="hidden"
                               asp-for="@Model[i].RoleId" />

                        <input type="hidden"
                               asp-for="@Model[i].RoleName" />

                        <input asp-for="@Model[i].isSelected"
                               class="form-check-input" />

                        <label class="form-check-label"
                               asp-for="@Model[i].isSelected">
                            @Model[i].RoleName</label>
                    </div>
                }

            </div>
            <div class="card-footer">
                <input type="submit" value="update Roles" class="btn btn-primary" />
                <button type="submit"
                        class="btn btn-primary">
                    Update Roles
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </div>

        </div>

    </form>

</div>
