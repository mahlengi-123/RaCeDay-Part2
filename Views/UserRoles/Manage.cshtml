@model List<RaCeDay.Models.ViewModels.ManageUserRolesViewModel>

@{
    ViewData["Title"] = "Manage User Roles";
    var userId = ViewBag.UserId as string;
    var userName = ViewBag.UserName as string;
}

<div class="container mt-4">

    <h2>
        Manage Roles for:
        <strong>@(userName ?? "User")</strong>
    </h2>

    <hr />

    <form asp-controller="UserRoles"
          asp-action="Manage"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="userId"
               value="@userId" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="card">

            <div class="card-header">
                Add / Remove Roles
            </div>

            <div class="card-body">

                @for (int i = 0; i < Model.Count; i++)
                {
                    <div class="form-check mb-2">

                        <input type="hidden"
                               asp-for="@Model[i].RoleId" />

                        <input type="hidden"
                               asp-for="@Model[i].RoleName" />

                        <input asp-for="@Model[i].isSelected"
                               class="form-check-input" />

                        <label class="form-check-label"
                               for="@Html.IdFor(m => m[i].isSelected)">
                            @Model[i].RoleName
                        </label>

                    </div>
                }

            </div>

            <div class="card-footer">

                <button type="submit"
                        class="btn btn-primary">
                    Update Roles
                </button>

                <a asp-controller="UserRoles"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
